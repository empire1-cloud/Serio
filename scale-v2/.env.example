PORT=3001
NODE_ENV=development
DATABASE_URL=postgres://fable5_app:fable5_app@localhost:5432/fable5
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/fable5
SESSION_TTL_HOURS=12
BOOTSTRAP_TENANT_NAME=Empire-1
BOOTSTRAP_ADMIN_EMAIL=monieq113@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-production
APP_ORIGIN=http://localhost:3001

# ── Receipt integrity / key custody ─────────────────────────────────
# Production FAILS CLOSED without a private Ed25519 signing key and key ID.
# Generate a pair with: npm run receipts:keygen
# Put the PRIVATE value in a secret manager / KMS-backed deployment secret.
# Never commit it. The public key is safe to publish to verifiers.
# Development/test uses an explicitly labelled deterministic dev key when
# these are empty; NODE_ENV=production never does.
RECEIPT_SIGNING_KEY_ID=
RECEIPT_SIGNING_PRIVATE_KEY_B64=
RECEIPT_SIGNING_PUBLIC_KEY_B64=
# Public keys of retired signing keys, as {"<key_id>":"<public_key_b64>"}.
# Receipts signed with them keep verifying. Rotate with: npm run receipts:rotate
# (procedure: RECEIPT_KEY_ROTATION.md)
RECEIPT_RETIRED_PUBLIC_KEYS_JSON=

# ── Stripe (optional) ────────────────────────────────────────────────
# Billing is HONESTLY GATED: with these unset, /api/billing/checkout
# refuses with 503 and the UI says checkout is unavailable. It never
# fabricates a session or silently upgrades a tenant.
#
# Price IDs are NOT configured here. They are resolved from Stripe by
# metadata (plan_key + billing_interval), and the amount is reconciled
# against src/domain/plans.js on every lookup — if Stripe and the app
# disagree on the price, checkout is REFUSED rather than charging a
# number the customer was never shown.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. Without it the webhook refuses to trust an unsigned body.
STRIPE_WEBHOOK_SECRET=
