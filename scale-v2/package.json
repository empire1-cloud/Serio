{
  "name": "fable5-scale-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "FABLE-5 evidence-governed company control plane",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "migrate": "node scripts/migrate.js",
    "bootstrap": "node scripts/bootstrap-admin.js",
    "seed:demo-genome": "node scripts/seed-demo-genome.js",
    "receipts:keygen": "node scripts/generate-receipt-key.js",
    "receipts:verify": "node scripts/verify-receipt-proof.js",
    "receipts:rotate": "node scripts/rotate-receipt-key.js",
    "check": "node --check src/server.js && node --check src/receipt-integrity.js && node --check src/domain/receipt-integrity.js && node --check scripts/seed-demo-genome.js && node --check scripts/generate-receipt-key.js && node --check scripts/verify-receipt-proof.js && node --check scripts/rotate-receipt-key.js",
    "start:deploy": "node scripts/migrate.js && node src/server.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "stripe": "^22.5.0"
  },
  "engines": {
    "node": ">=22"
  }
}
